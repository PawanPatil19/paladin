EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_AUTH_REDIRECT_URL=paladin://reset-password

# Web map tiles. Use a contracted tile provider for public production traffic.
EXPO_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Development preview only. This is ignored by production bundles.
EXPO_PUBLIC_DEMO_MODE=false

# Server only. Never prefix these with EXPO_PUBLIC_ or include them in a mobile build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
ALLOWED_ORIGIN=https://your-web-app.example.com

# Server-side OSRM-compatible pedestrian and bicycle routing services.
# Defaults to the OpenStreetMap.de community routers for local development.
ROUTING_RUN_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_RIDE_URL=https://routing.openstreetmap.de/routed-bike
